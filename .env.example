# Environment variables. Placeholders only; never commit .env.local.
# NEXT_PUBLIC_* values are public and baked in at build time (redeploy after
# changing). Everything else is server-only. Empty means unset.
# Restart `npm run dev` after edits. VERCEL, VERCEL_ENV and NODE_ENV are set
# by the platform; do not set them.
#
#   Variable                        Local          Vercel Production     Vercel Preview
#   SITE_URL                        optional       unset                 unset
#   BREVO_API_KEY                   send tests     required, Sensitive   optional
#   CONTACT_FROM_EMAIL              send tests     required              optional
#   CONTACT_TO_EMAIL                send tests     required              optional
#   UPSTASH_REDIS_REST_URL          send tests     required              optional
#   UPSTASH_REDIS_REST_TOKEN        send tests     required, Sensitive   optional
#   CONTACT_HASH_SALT               send tests     required, Sensitive   optional
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY  test key       required              required
#   TURNSTILE_SECRET_KEY            test secret    required, Sensitive   required
#   CONTACT_ALLOWED_HOSTNAMES       optional       required              optional
#
# The site runs without any of these; the contact form then reports that it is
# unavailable and offers a direct email instead.


# ---- Local (.env.local) -----------------------------------------------------

# Origin override, only for another local port. The production origin
# (https://www.kamandagroup.com) is in src/lib/site.ts; development and Vercel
# Previews are detected automatically.
SITE_URL=

# Cloudflare Turnstile test keys (always pass). Real keys go in Vercel.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Hostnames allowed to submit the form, comma-separated. Defaults to this
# deployment's own host, so it is optional except to allow extra hosts.
CONTACT_ALLOWED_HOSTNAMES=

# Only for real send tests. Mail goes to the real inbox.
BREVO_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CONTACT_HASH_SALT=


# ---- Vercel Production (set in Vercel, not here) ---------------------------

# Brevo: API key (Sensitive), verified sender, enquiry inbox.
# BREVO_API_KEY=<Brevo > SMTP & API > API keys>
# CONTACT_FROM_EMAIL=no-reply@kamandagroup.com
# CONTACT_TO_EMAIL=info@kamandagroup.com

# Upstash Redis for rate limits and duplicate protection.
# UPSTASH_REDIS_REST_URL=<https://...upstash.io>
# UPSTASH_REDIS_REST_TOKEN=<token>

# Salt for hashing IPs and emails, 32+ characters: `openssl rand -hex 32`.
# CONTACT_HASH_SALT=<random secret>

# Cloudflare Turnstile: Managed widget listing the production and preview
# hostnames. The site key is public; the secret key is Sensitive.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=<site key>
# TURNSTILE_SECRET_KEY=<secret key>

# The apex redirects to www, so list both.
# CONTACT_ALLOWED_HOSTNAMES=kamandagroup.com,www.kamandagroup.com
